<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ClockTextBase">
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>

    <style name="ClockMetaBase">
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="ClockText.Sans.Light" parent="ClockTextBase">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textStyle">normal</item>
    </style>
    <style name="ClockText.Sans.Regular" parent="ClockTextBase">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">normal</item>
    </style>
    <style name="ClockText.Sans.Bold" parent="ClockTextBase">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ClockText.Condensed.Light" parent="ClockTextBase">
        <item name="android:fontFamily">sans-serif-condensed-light</item>
        <item name="android:textStyle">normal</item>
    </style>
    <style name="ClockText.Condensed.Regular" parent="ClockTextBase">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">normal</item>
    </style>
    <style name="ClockText.Condensed.Bold" parent="ClockTextBase">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ClockText.Mono.Light" parent="ClockTextBase">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">normal</item>
    </style>
    <style name="ClockText.Mono.Regular" parent="ClockTextBase">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">normal</item>
    </style>
    <style name="ClockText.Mono.Bold" parent="ClockTextBase">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ClockText.Display.Light" parent="ClockTextBase">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textStyle">normal</item>
    </style>
    <style name="ClockText.Display.Regular" parent="ClockTextBase">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
    </style>
    <style name="ClockText.Display.Bold" parent="ClockTextBase">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
