<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ClockTextBase">
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">12sp</item>
        <item name="android:autoSizeMaxTextSize">240sp</item>
        <item name="android:autoSizeStepGranularity">2sp</item>
    </style>

    <style name="ClockText.Display.Light" parent="ClockTextBase">
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textStyle">normal</item>
    </style>
    <style name="ClockText.Display.Regular" parent="ClockTextBase">
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textStyle">normal</item>
    </style>
    <style name="ClockText.Display.Bold" parent="ClockTextBase">
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
