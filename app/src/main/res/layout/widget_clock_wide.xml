<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_frosted_dark"
    android:contentDescription="@string/cd_open_clock"
    android:padding="3dp">

    <LinearLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/main_horizontal_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/time_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/time_layer_frame"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextClock
                    android:id="@+id/tc_ampm"
                    style="@style/ClockText.Sans.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_marginBottom="3dp"
                    android:format12Hour="a"
                    android:format24Hour=""
                    android:textColor="@color/sky_400"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/meta_beside_column"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:gravity="start|center_vertical"
                android:orientation="vertical">

                <TextClock
                    android:id="@+id/tc_date_beside"
                    style="@style/ClockText.Sans.Regular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="EEE, MMM d"
                    android:format24Hour="EEE, d MMM"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/alarm_container_beside"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_alarm_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="2dp">

                    <ImageView
                        android:id="@+id/iv_alarm_beside"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:contentDescription="@string/cd_alarm_icon"
                        android:src="@drawable/ic_alarm_clock" />

                    <TextView
                        android:id="@+id/tv_alarm_beside"
                        style="@style/ClockText.Sans.Bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:textColor="@color/amber_500"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/meta_below_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextClock
                android:id="@+id/tc_date_below"
                style="@style/ClockText.Sans.Regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="EEEE, MMM d"
                android:format24Hour="EEEE, d MMM"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/alarm_container_below"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_alarm_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp">

                <ImageView
                    android:id="@+id/iv_alarm_below"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:contentDescription="@string/cd_alarm_icon"
                    android:src="@drawable/ic_alarm_clock" />

                <TextView
                    android:id="@+id/tv_alarm_below"
                    style="@style/ClockText.Sans.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/amber_500"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
